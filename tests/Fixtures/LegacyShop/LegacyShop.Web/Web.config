<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="billing" type="Acme.Internal.Billing.BillingSection, Acme.Internal.Billing" />
  </configSections>
  <billing endpoint="https://billing.local" />
  <connectionStrings>
    <add name="ShopDb" connectionString="Server=.;Database=Shop;Trusted_Connection=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState mode="InProc" timeout="20" />
    <httpModules>
      <add name="AuditModule" type="LegacyShop.Web.AuditModule, LegacyShop.Web" />
    </httpModules>
  </system.web>
  <system.webServer>
    <modules>
      <add name="AuditModule" type="LegacyShop.Web.AuditModule, LegacyShop.Web" />
    </modules>
    <handlers>
      <add name="ReportHandler" path="report.axd" verb="GET" type="LegacyShop.Web.ReportHandler, LegacyShop.Web" />
    </handlers>
  </system.webServer>
  <system.serviceModel>
    <client>
      <endpoint address="http://localhost/OrderService.svc" binding="basicHttpBinding" contract="OrderServiceRef.IOrderService" name="BasicHttpBinding_IOrderService" />
    </client>
  </system.serviceModel>
</configuration>
