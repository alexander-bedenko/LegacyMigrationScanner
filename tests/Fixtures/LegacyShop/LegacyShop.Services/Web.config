<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <services>
      <service name="LegacyShop.Services.OrderService">
        <endpoint address="" binding="basicHttpBinding" contract="LegacyShop.Services.IOrderService" />
        <endpoint address="secure" binding="wsHttpBinding" contract="LegacyShop.Services.IOrderService" />
      </service>
    </services>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
</configuration>
