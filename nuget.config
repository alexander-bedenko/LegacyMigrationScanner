<?xml version="1.0" encoding="utf-8"?>
<!-- Repository-local feed config: only nuget.org, so restore is reproducible regardless of machine-wide feeds.
     No packageSourceMapping on purpose: it rejects the add-source option of `dotnet tool install` (used by the CI smoke test). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
