<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LegacyMigrationScanner.Core</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>LegacyMigrationScanner.Core</PackageId>
    <Description>Analysis engine of Legacy Migration Scanner: detects .NET Framework to modern .NET migration blockers and estimates effort.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Rules\rules.json" LogicalName="LegacyMigrationScanner.rules.json" />
    <EmbeddedResource Include="Packages\known-packages.json" LogicalName="LegacyMigrationScanner.known-packages.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LegacyMigrationScanner.Tests" />
  </ItemGroup>
</Project>
