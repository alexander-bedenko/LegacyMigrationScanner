{
  // pattern: exact package id, or prefix ending with '*'. Exact matches win, then the longest prefix.
  // action: compatible | upgrade | replace | remove | incompatible | review
  "packages": [
    { "pattern": "Microsoft.AspNet.WebApi.Client", "action": "compatible" },
    { "pattern": "Microsoft.AspNet.WebApi*", "action": "replace", "replacement": "ASP.NET Core (built into Microsoft.AspNetCore.App)" },
    { "pattern": "Microsoft.AspNet.Mvc*", "action": "replace", "replacement": "ASP.NET Core MVC (built-in)" },
    { "pattern": "Microsoft.AspNet.Razor*", "action": "replace", "replacement": "ASP.NET Core Razor (built-in)" },
    { "pattern": "Microsoft.AspNet.WebPages*", "action": "replace", "replacement": "ASP.NET Core Razor (built-in)" },
    { "pattern": "Microsoft.AspNet.Cors", "action": "replace", "replacement": "ASP.NET Core CORS middleware (built-in)" },
    { "pattern": "Microsoft.AspNet.Web.Optimization*", "action": "replace", "replacement": "WebOptimizer or a front-end build (Vite/webpack)" },
    { "pattern": "WebGrease", "action": "remove" },
    { "pattern": "Antlr", "action": "remove" },
    { "pattern": "Microsoft.AspNet.Identity*", "action": "replace", "replacement": "ASP.NET Core Identity (schema differs - plan data migration)" },
    { "pattern": "Microsoft.AspNet.SignalR*", "action": "replace", "replacement": "ASP.NET Core SignalR (protocol incompatible: clients must be updated too)" },
    { "pattern": "Microsoft.AspNet.SessionState*", "action": "replace", "replacement": "ASP.NET Core session middleware" },
    { "pattern": "Microsoft.AspNet.TelemetryCorrelation", "action": "remove" },
    { "pattern": "Microsoft.ApplicationInsights.Web", "action": "replace", "replacement": "Microsoft.ApplicationInsights.AspNetCore or OpenTelemetry" },
    { "pattern": "Microsoft.Owin.Security*", "action": "replace", "replacement": "ASP.NET Core authentication handlers (Microsoft.AspNetCore.Authentication.*)" },
    { "pattern": "Microsoft.Owin*", "action": "replace", "replacement": "ASP.NET Core middleware pipeline" },
    { "pattern": "Owin", "action": "remove" },
    { "pattern": "Microsoft.CodeDom.Providers.DotNetCompilerPlatform", "action": "remove" },
    { "pattern": "Microsoft.Net.Compilers*", "action": "remove" },
    { "pattern": "Microsoft.Web.Infrastructure", "action": "remove" },
    { "pattern": "Unity.WebAPI", "action": "replace", "replacement": "Microsoft.Extensions.DependencyInjection (or Unity.Microsoft.DependencyInjection)" },
    { "pattern": "Unity.Mvc*", "action": "replace", "replacement": "Microsoft.Extensions.DependencyInjection (or Unity.Microsoft.DependencyInjection)" },
    { "pattern": "Unity.AspNet.WebApi", "action": "replace", "replacement": "Microsoft.Extensions.DependencyInjection (or Unity.Microsoft.DependencyInjection)" },
    { "pattern": "Autofac.WebApi*", "action": "replace", "replacement": "Autofac.Extensions.DependencyInjection" },
    { "pattern": "Autofac.Mvc*", "action": "replace", "replacement": "Autofac.Extensions.DependencyInjection" },
    { "pattern": "Autofac.Owin", "action": "replace", "replacement": "Autofac.Extensions.DependencyInjection" },
    { "pattern": "Ninject.Web*", "action": "replace", "replacement": "Microsoft.Extensions.DependencyInjection" },
    { "pattern": "Swashbuckle", "action": "replace", "replacement": "Swashbuckle.AspNetCore or Microsoft.AspNetCore.OpenApi" },
    { "pattern": "Swashbuckle.Core", "action": "replace", "replacement": "Swashbuckle.AspNetCore or Microsoft.AspNetCore.OpenApi" },
    { "pattern": "EntityFramework", "action": "upgrade", "minVersion": "6.3.0", "replacement": "EntityFramework 6.5.x (or migrate to EF Core separately)" },
    { "pattern": "WindowsAzure.ServiceBus", "action": "replace", "replacement": "Azure.Messaging.ServiceBus" },
    { "pattern": "Microsoft.Azure.ServiceBus", "action": "replace", "replacement": "Azure.Messaging.ServiceBus" },
    { "pattern": "WindowsAzure.Storage", "action": "replace", "replacement": "Azure.Storage.Blobs / Azure.Storage.Queues / Azure.Data.Tables" },
    { "pattern": "Microsoft.Azure.Storage*", "action": "replace", "replacement": "Azure.Storage.Blobs / Azure.Storage.Queues" },
    { "pattern": "NEST", "action": "review", "replacement": "Elastic.Clients.Elasticsearch (for Elasticsearch 8+)" },
    { "pattern": "Elasticsearch.Net", "action": "review", "replacement": "Elastic.Clients.Elasticsearch (for Elasticsearch 8+)" },
    { "pattern": "System.Data.SqlClient", "action": "review", "replacement": "Microsoft.Data.SqlClient" },
    { "pattern": "EnterpriseLibrary*", "action": "incompatible", "replacement": "Microsoft.Extensions.* (logging, caching, DI), Polly for retries" },
    { "pattern": "Microsoft.ReportViewer*", "action": "review", "replacement": "Web Forms ReportViewer has no ASP.NET Core version; consider SSRS REST API or a third-party viewer" },
    { "pattern": "CrystalReports*", "action": "incompatible" },

    { "pattern": "Newtonsoft.Json", "action": "compatible" },
    { "pattern": "log4net", "action": "compatible" },
    { "pattern": "NLog*", "action": "compatible" },
    { "pattern": "Serilog*", "action": "compatible" },
    { "pattern": "AutoMapper*", "action": "compatible" },
    { "pattern": "Dapper*", "action": "compatible" },
    { "pattern": "FluentValidation*", "action": "compatible" },
    { "pattern": "MediatR*", "action": "compatible" },
    { "pattern": "Polly*", "action": "compatible" },
    { "pattern": "StackExchange.Redis", "action": "compatible" },
    { "pattern": "RabbitMQ.Client", "action": "compatible" },
    { "pattern": "MassTransit*", "action": "compatible" },
    { "pattern": "Castle.Core", "action": "compatible" },
    { "pattern": "Castle.Windsor", "action": "compatible" },
    { "pattern": "Autofac", "action": "compatible" },
    { "pattern": "Unity.Container", "action": "compatible" },
    { "pattern": "Moq", "action": "compatible" },
    { "pattern": "NSubstitute", "action": "compatible" },
    { "pattern": "xunit*", "action": "compatible" },
    { "pattern": "NUnit*", "action": "compatible" },
    { "pattern": "MSTest*", "action": "compatible" },
    { "pattern": "FluentAssertions", "action": "compatible" },
    { "pattern": "Azure.*", "action": "compatible" },
    { "pattern": "Microsoft.Extensions.*", "action": "compatible" },
    { "pattern": "Microsoft.Data.SqlClient", "action": "compatible" },
    { "pattern": "Microsoft.IdentityModel.*", "action": "compatible" },
    { "pattern": "System.IdentityModel.Tokens.Jwt", "action": "compatible" },
    { "pattern": "System.*", "action": "compatible" }
  ]
}
