<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LegacyMigrationScanner.Cli</RootNamespace>
    <AssemblyName>lms</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lms</ToolCommandName>
    <PackageId>LegacyMigrationScanner</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>dotnet tool that scans .NET Framework 4.x solutions and reports migration blockers (System.Web, WCF, incompatible packages) with an effort estimate for modern .NET.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LegacyMigrationScanner.Core\LegacyMigrationScanner.Core.csproj" />
    <ProjectReference Include="..\LegacyMigrationScanner.Mcp\LegacyMigrationScanner.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LegacyMigrationScanner.Tests" />
  </ItemGroup>
</Project>
